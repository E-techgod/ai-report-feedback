# Server-only. Never prefix these with NEXT_PUBLIC_.

# Google Sheets (POST /api/questionnaire). The sheet must be shared with the service account
# (Editor) and the Google Sheets API must be enabled in the service account's Cloud project.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Keep on one line, wrapped in quotes, with literal \n between lines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: AI-generated summary. Without both, the deterministic fallback is shown.
ANTHROPIC_API_KEY=
# Exact model ID available in your Anthropic account.
ANTHROPIC_MODEL=

# Public: published Google Appointment Schedule booking page.
# Inlined at build time: after changing it in Vercel, redeploy.
NEXT_PUBLIC_BOOKING_URL=https://www.quirongroup.com/calendario-jag

# Legacy (only used by the old /api/submit Apps Script bridge, no longer called by the UI):
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_SECRET=
