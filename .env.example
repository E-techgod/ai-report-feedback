# Server-only. Never prefix these with NEXT_PUBLIC_.

# Google Sheets (POST /api/questionnaire). The sheet must be shared with the service account
# (Editor) and the Google Sheets API must be enabled in the service account's Cloud project.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Keep on one line, wrapped in quotes, with literal \n between lines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI writes the 4 narrative slots of the report (never more than 15% of its visible words). If the
# provider is missing, rate-limited or failing, the report is finalized with template text and says
# so explicitly (it is never presented as AI-written).
# Provider: "groq" (default when unset) or "anthropic". Any other value uses template text.
# Production: do not rely on the default; set this explicitly and verify it before deploying.
AI_PROVIDER=groq
# Groq (console.groq.com). Server-only.
GROQ_API_KEY=
# Defaults to openai/gpt-oss-20b when empty.
GROQ_MODEL=openai/gpt-oss-20b

# Only used when AI_PROVIDER=anthropic. ANTHROPIC_MODEL is the exact model ID in your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Postgres (Neon via Vercel). Stores finalized reports + email status. Run `npm run db:migrate` once.
DATABASE_URL=
# Direct (non-pooled) URL, used by `npm run db:migrate`. `neon env pull` writes both.
DATABASE_URL_UNPOOLED=

# Random secret (>= 32 chars, e.g. `openssl rand -hex 32`). Signs the per-report access token.
REPORT_TOKEN_SECRET=

# Email (Resend). Nothing is sent unless REPORT_EMAIL_ENABLED=true AND the two values below are set.
RESEND_API_KEY=
# Verified sender, e.g. "Quirón <diagnostico@quirongroup.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=
# Master switch. Leave unset/false until the migration is approved.
REPORT_EMAIL_ENABLED=false
# Optional test gate. When set, ONLY these comma-separated addresses are ever emailed; every other
# report is stored as "disabled". Leave empty for normal operation. A value with no valid address
# emails nobody. Set it in the Vercel dashboard (it is not part of the env sync).
REPORT_EMAIL_ALLOWLIST=
# Signing secret of the Resend webhook (https://<your-domain>/api/webhooks/resend), starts with whsec_
RESEND_WEBHOOK_SECRET=
# Public base URL of this app (the email loads its logo from <APP_URL>/images/quiron-logo.png), e.g.
# https://shield.quirongroup.com. Must be public HTTPS (not localhost). If unset, the production domain
# Vercel provides (VERCEL_PROJECT_PRODUCTION_URL) is used; with neither, the email shows a text logo.
APP_URL=

# Secret Vercel Cron sends as "Authorization: Bearer ..." to /api/cron/retry-emails (>= 16 chars).
CRON_SECRET=

# Public: published Google Appointment Schedule booking page.
# Inlined at build time: after changing it in Vercel, redeploy.
NEXT_PUBLIC_BOOKING_URL=https://www.quirongroup.com/calendario-jag

# Legacy (only used by the old /api/submit Apps Script bridge, no longer called by the UI):
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_SECRET=
