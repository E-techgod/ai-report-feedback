# Server-only. Never prefix these with NEXT_PUBLIC_.

# Google Sheets (POST /api/questionnaire). The sheet must be shared with the service account
# (Editor) and the Google Sheets API must be enabled in the service account's Cloud project.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Keep on one line, wrapped in quotes, with literal \n between lines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI writes the 4 narrative slots of the report (never more than 15% of its visible words). If the
# provider is missing, rate-limited or failing, the report is finalized with template text and says
# so explicitly (it is never presented as AI-written).
# Provider: "groq" (default when unset) or "anthropic". Any other value uses template text.
# Production: do not rely on the default; set this explicitly and verify it before deploying.
AI_PROVIDER=groq
# Groq (console.groq.com). Server-only.
GROQ_API_KEY=
# Defaults to openai/gpt-oss-20b when empty.
GROQ_MODEL=openai/gpt-oss-20b

# Only used when AI_PROVIDER=anthropic. ANTHROPIC_MODEL is the exact model ID in your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Random secret (>= 32 chars, e.g. `openssl rand -hex 32`). Signs the 5-minute PDF download grant.
# Nothing is stored: any function instance verifies a grant with this secret alone.
REPORT_TOKEN_SECRET=

# Public: published Google Appointment Schedule booking page.
# Inlined at build time: after changing it in Vercel, redeploy.
NEXT_PUBLIC_BOOKING_URL=https://www.quirongroup.com/calendario-jag

# Legacy (only used by the old /api/submit Apps Script bridge, no longer called by the UI):
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_SECRET=
