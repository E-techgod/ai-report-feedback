{
  "name": "quiron-shield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "node --import tsx scripts/env-sync-production.ts --check",
    "env:sync:preview": "node --import tsx scripts/env-sync-production.ts --target preview",
    "env:sync:production": "node --import tsx scripts/env-sync-production.ts",
    "test:live": "LIVE_TEST=1 node --import tsx --test --test-concurrency=1 tests/live/live.test.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "googleapis": "^190.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "unpdf": "^1.9.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
